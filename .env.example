# Copier ce fichier vers .env avant de lancer l’app.
#   macOS / Linux :  cp .env.example .env
#   Windows PowerShell :  Copy-Item .env.example .env
# Puis :  npm install
#         npx expo start
# Touche w : navigateur (ou npm run web, http://127.0.0.1:43123).
# Expo Go : scanner le QR code, téléphone et PC sur le même Wi-Fi.
# Comptes de démonstration, mode local seulement (mot de passe nanometre) :
#   alex.gagnon@exemple.ca  client
#   karim@lenanometre.ca    propriétaire
#   julien.morel@lenanometre.ca  coiffeur
# Ne jamais les créer sur le projet Supabase hébergé.
# Laisser les valeurs vides : l’app tourne en local, sans secret.
# Un build de production exige EXPO_PUBLIC_DATA_SOURCE=supabase et l’URL + la clé anon.
# local : données de démonstration (défaut si l’URL est vide)
# supabase : Postgres + Auth du projet
EXPO_PUBLIC_DATA_SOURCE=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clé publiable Stripe, mode test (pk_test_…). Jamais la clé secrète.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry : laisser vide pour désactiver. Aucun courriel ni téléphone n’est envoyé.
EXPO_PUBLIC_SENTRY_DSN=

# 1 seulement avec un build de développement (__DEV__) : l’espace équipe s’ouvre
# sur le 3 octobre 2026. Sans ce drapeau, ou en production, la date est aujourd’hui
# (America/Toronto).
EXPO_PUBLIC_DEMO_DATE=

# Secrets de la Edge Function, à poser dans le tableau Supabase (jamais dans l’app) :
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# CRON_SECRET=          (au moins 16 caractères ; pas la clé service_role)
# EXPO_ACCESS_TOKEN=    (sécurité renforcée des notifications Expo)
# INVITE_REDIRECT_URL=https://lenanometre.ca/auth/callback
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés par Supabase.
